#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-only
# A stand-in for BlueZ's bluetoothctl in interactive mode, for tests/ble_central_tool.py: the lines the real one prints,
# with its colours and prompt, for the commands tools/ble_central.py sends. Made up from bluetoothctl's output format,
# not recorded. FAKE_BLUEZ_STATE: a directory for the commands and the "connected" port; FAKE_BLUEZ_MODE: ok, nostack
# (the stack's address never heard), nomidi (no sequencer port after connecting), noconnect (the connection fails).
import os
import sys
st, mode = os.environ["FAKE_BLUEZ_STATE"], os.environ.get("FAKE_BLUEZ_MODE", "ok")
P = "\x1b[0;94m[bluetooth]\x1b[0m# "


def out(s):
    sys.stdout.write(s + "\n")
    sys.stdout.flush()


out("Agent registered")
for line in sys.stdin:
    cmd = line.strip()
    with open(os.path.join(st, "cmds.txt"), "a") as f:
        f.write(cmd + "\n")
    if cmd == "scan le":
        out(P + "SetDiscoveryFilter success")
        out("Discovery started")
        out("[\x1b[0;93mCHG\x1b[0m] Controller 00:11:22:33:44:55 Discovering: yes")
        out("[\x1b[0;92mNEW\x1b[0m] Device 11:22:33:44:55:66 SomethingElse")
        out("[\x1b[0;92mNEW\x1b[0m] Device C2:46:4D:31:00:10 C2-46-4D-31-00-10")
        out("[\x1b[0;93mCHG\x1b[0m] Device C2:46:4D:31:00:10 RSSI: 0xffffffbd (-67)")
        out(P + "[\x1b[0;92mNEW\x1b[0m] Device C2:46:4D:31:00:11 OPLBOX")
        out("[\x1b[0;93mCHG\x1b[0m] Device C2:46:4D:31:00:11 RSSI: -71")
        if mode != "nostack":
            out("[\x1b[0;92mNEW\x1b[0m] Device C2:46:4D:31:00:01 OPLBOX")
    elif cmd == "scan off":
        out("Discovery stopped")
    elif cmd.startswith("connect "):
        a = cmd.split()[1]
        out(f"Attempting to connect to {a}")
        if mode == "noconnect":
            out("Failed to connect: org.bluez.Error.Failed le-connection-abort-by-local")
            continue
        out(f"[\x1b[0;93mCHG\x1b[0m] Device {a} Connected: yes")
        out("Connection successful")
        if mode != "nomidi":
            open(os.path.join(st, "port"), "w").close()
    elif cmd.startswith("disconnect "):
        out(f"Attempting to disconnect from {cmd.split()[1]}")
        out("Successful disconnected")
        if os.path.exists(os.path.join(st, "port")):
            os.remove(os.path.join(st, "port"))
    elif cmd == "quit":
        break
